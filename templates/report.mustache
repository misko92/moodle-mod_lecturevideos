{{!
    @template mod_lecturevideos/report

    One row per student (overall bar under the name); click to expand the per-video detail.

    Example context (json):
    {
        "name": "Videos Lecture 01", "backurl": "#", "hasstudents": true, "trackcompletion": true,
        "summary": "1 of 2 students complete",
        "students": [{"userid": 9, "fullname": "Test Student", "overall": 40, "watchedcount": 1, "videocount": 2,
            "trackcompletion": true, "complete": false, "lastwatched": "18/11/26, 12:04", "notstarted": false,
            "videos": [{"title": "1.01 History of the Atom", "percent": 80, "completed": false, "started": true,
                "segments": [{"left": 0, "width": 80}], "watchtime": "6:00", "length": "7:15",
                "lastwatched": "18/11/26, 12:04"}]}]
    }
}}
<div class="mod-lecturevideos-report" data-region="lv-report">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h4 mb-1">{{#str}}reporttitle, lecturevideos{{/str}}: {{name}}</h2>
            <div class="text-muted">{{summary}}</div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="expand-all">{{#str}}expandall{{/str}}</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="collapse-all">{{#str}}collapseall{{/str}}</button>
            <a class="btn btn-secondary btn-sm" href="{{{backurl}}}">{{#str}}back, lecturevideos{{/str}}</a>
        </div>
    </div>
    {{^hasstudents}}<div class="alert alert-info">{{#str}}nostudents, lecturevideos{{/str}}</div>{{/hasstudents}}
    {{#hasstudents}}
    <div class="list-group">
        {{#students}}
        <details class="list-group-item lvr-student" data-region="student">
            <summary class="lvr-summary">
                <span class="lvr-name">
                    <span class="fw-semibold">{{fullname}}</span>
                    <span class="progress lvr-overall" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                          aria-valuenow="{{overall}}" aria-label="{{#str}}overallprogress, lecturevideos{{/str}}">
                        <span class="progress-bar{{#complete}} bg-success{{/complete}}" style="width: {{overall}}%"></span>
                    </span>
                </span>
                <span class="lvr-figures small">
                    <span class="fw-semibold">{{overall}}%</span>
                    <span class="text-muted">{{#str}}videoswatched, lecturevideos, {"done": {{watchedcount}}, "total": {{videocount}} }{{/str}}</span>
                </span>
                <span class="lvr-status small">
                    {{#trackcompletion}}
                        {{#complete}}<span class="badge bg-success">✓ {{#str}}complete, lecturevideos{{/str}}</span>{{/complete}}
                        {{^complete}}<span class="badge bg-secondary">{{#str}}notcomplete, lecturevideos{{/str}}</span>{{/complete}}
                    {{/trackcompletion}}
                    <span class="text-muted">{{#notstarted}}{{#str}}notstarted, lecturevideos{{/str}}{{/notstarted}}{{^notstarted}}{{lastwatched}}{{/notstarted}}</span>
                </span>
            </summary>
            <table class="table table-sm lvr-videos mt-2 mb-1">
                <thead>
                <tr>
                    <th scope="col">{{#str}}videotitle, lecturevideos{{/str}}</th>
                    <th scope="col" class="lvr-col-bar">{{#str}}partswatched, lecturevideos{{/str}}</th>
                    <th scope="col">%</th>
                    <th scope="col">{{#str}}watchtime, lecturevideos{{/str}}</th>
                    <th scope="col">{{#str}}lastwatched, lecturevideos{{/str}}</th>
                </tr>
                </thead>
                <tbody>
                {{#videos}}
                <tr>
                    <td>{{title}}{{#length}} <span class="text-muted small">({{length}})</span>{{/length}}</td>
                    <td class="lvr-col-bar"><span class="lvr-timeline">{{#segments}}<span style="left: {{left}}%; width: {{width}}%"></span>{{/segments}}</span></td>
                    <td>{{percent}}%{{#completed}} ✓{{/completed}}</td>
                    <td>{{watchtime}}</td>
                    <td class="text-muted">{{lastwatched}}</td>
                </tr>
                {{/videos}}
                </tbody>
            </table>
        </details>
        {{/students}}
    </div>
    {{/hasstudents}}
</div>
